{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "deletions": {
      "default": [],
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "maxLength": 1000000
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "instances": {
      "default": [],
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(Workspace|ReplicatedStorage|ServerScriptService|ServerStorage|StarterGui|StarterPlayer|Lighting|SoundService)(\\/[\\w .-]+)*$"
          },
          "className": {
            "type": "string",
            "pattern": "^\\w+$"
          },
          "properties": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "source": {
            "type": "string",
            "maxLength": 500000
          }
        },
        "required": [
          "path",
          "className",
          "properties"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "device": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "required",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "minor",
              "info"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "summary",
    "deletions",
    "files",
    "instances",
    "checks",
    "findings",
    "data"
  ],
  "additionalProperties": false
}